# Copia este archivo como .env y cambia TU_PASSWORD por la contrasena
# de root de tu MySQL. La base "gimnasio" no hace falta crearla a
# mano: `prisma migrate dev` la crea si no existe.
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/gimnasio"

# Quien tenga este secreto puede firmar tokens validos: nunca se sube a Git.
# Por lo menos 32 caracteres. Este es SOLO de ejemplo, en tu .env pon otro.
JWT_SECRET="algo-largo-y-aleatorio-cambialo-por-uno-tuyo-de-32+"
